# WalletConnect Project ID (required for RainbowKit)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# API Keys (optional - for enhanced data)
NEXT_PUBLIC_COINGECKO_API_KEY=
NEXT_PUBLIC_ONDO_API_KEY=
NEXT_PUBLIC_DINARI_API_KEY=

# RPC URLs (optional - defaults to public RPCs)
NEXT_PUBLIC_ETHEREUM_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_ARBITRUM_RPC_URL=

# Hyperliquid API (mainnet)
NEXT_PUBLIC_HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
